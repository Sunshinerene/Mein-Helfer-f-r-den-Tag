<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/assistant_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/assistant_placeholder" />

    <TextView
        android:id="@+id/assistant_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/assistant_title" />

    <TextView
        android:id="@+id/assistant_copy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/assistant_explanation" />
</LinearLayout>
