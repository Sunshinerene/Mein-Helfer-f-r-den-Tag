<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path name="updates" path="updates/" />
    <!-- Fotos von Medikamentenpackungen (nur fuer die Kamera-App als Ziel freigegeben) -->
    <files-path name="photos" path="photos/" />
    <!-- Nachbestell-Listen als PDF (zum Teilen/Senden freigegeben) -->
    <files-path name="exports" path="exports/" />
    <!-- Entschluesselte Kopien von Dokumenten zum Oeffnen/Teilen (werden beim App-Start geloescht) -->
    <cache-path name="docs" path="docs/" />
    <!-- Fotos von Ausweis und Gesundheitskarte nur zum Auslesen (werden sofort danach geloescht) -->
    <cache-path name="scan" path="scan/" />
</paths>
